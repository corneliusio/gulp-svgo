{
    "compilerOptions": {
        "target": "es2024",
        "module": "nodenext",
        "moduleDetection": "force",
        "strict": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "types": ["node"]
    },
    "include": ["src", "test"]
}
